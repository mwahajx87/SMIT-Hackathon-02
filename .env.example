# =====================================================
# HCM Lite — environment template
# Copy to server/.env (backend) and client/.env (only VITE_* vars)
# NEVER commit a real .env. Commit only this file.
# =====================================================

# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Allowed browser origin(s) for CORS (comma-separated)
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# MongoDB Atlas free tier or local MongoDB
MONGODB_URI=mongodb+srv://wahaj19112006_db_user:VL0rPp7htEAKMTjL@cluster0.cagu5q4.mongodb.net/

# ---------- Auth ----------
# Use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=hcm_lite
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# ---------- First run (optional) ----------
# If the database is empty on boot, the server creates the company + Admin from these.
# Leave blank to use the First-run setup screen in the browser instead.
COMPANY_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Company defaults (used only when settings are first created) ----------
COMPANY_TIMEZONE=Asia/Karachi

# ---------- AI assistant (backend only — the browser never sees this) ----------
# Any hosted LLM API that supports tool calling. The free tier is enough.
AI_PROVIDER=gemini
AI_API_KEY=AQ.Ab8RN6KMAiVae40saklvYBLLzkpYI5wDFqTkv8AX9351F0MmFw
AI_MODEL=gemini-2.0-flash
# Only needed for OpenAI-compatible providers
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_TIMEOUT_MS=15000
AI_RATE_LIMIT_PER_HOUR=20

# ---------- Rate limiting ----------
LOGIN_RATE_LIMIT_PER_15MIN=20

# ---------- Client (copy only these into client/.env) ----------
VITE_API_URL=http://localhost:5000/api
